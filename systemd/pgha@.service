[Unit]
Description=pgha — PostgreSQL HA Heartbeat Manager — cluster %i
Documentation=https://github.com/yourorg/pgha
After=network-online.target
Wants=network-online.target
# Do NOT start before postgresql — pgha starts postgres itself

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/pgha-daemon --config /etc/pgha/pgha-%i.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
TimeoutStartSec=60s
TimeoutStopSec=30s

# Logging (journald captures stdout/stderr; file handler writes /var/log/pgha/)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pgha-%i

# Ensure runtime and log directories exist
# NOTE: Do NOT use RuntimeDirectory=pgha here — systemd would delete
# /var/run/pgha/ when ANY cluster instance stops, wiping other clusters' sockets.
ExecStartPre=/usr/bin/install -d -o root -g root -m 0755 /var/log/pgha
ExecStartPre=/usr/bin/install -d -o root -g root -m 0750 /var/run/pgha

# Security hardening
NoNewPrivileges=no
PrivateTmp=no
ProtectSystem=off

[Install]
WantedBy=multi-user.target
